{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vofa-ultra.dev/schemas/extension-v1.schema.json",
  "title": "Vofa-Ultra extension package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "manifest",
    "moduleSha256",
    "moduleBase64"
  ],
  "properties": {
    "format": {
      "const": "vofa-ultra-extension"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "description",
        "license",
        "apiVersion",
        "kind",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9.()+:/-](?:[A-Za-z0-9.()+:/ -]*[A-Za-z0-9.()+:/-])?$"
        },
        "apiVersion": {
          "const": 1
        },
        "kind": {
          "const": "protocol-parser"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "live-rx.read"
          }
        }
      }
    },
    "moduleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "moduleBase64": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1398104,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
