{
  "schemaVersion": 1,
  "workspace": {
    "fileFormat": "vofa-ultra.workspace",
    "writeVersion": 4,
    "readVersions": [1, 2, 3, 4],
    "futureVersionBehavior": "reject"
  },
  "localStorage": {
    "key": "vofa-ultra-workbench",
    "writeVersion": 4,
    "migrateFromVersions": [0, 1, 2, 3],
    "futureVersionBehavior": "preserve-read-only"
  },
  "capture": {
    "fileFormat": "VUCAP",
    "writeVersion": 2,
    "readVersions": [1, 2],
    "futureVersionBehavior": "reject"
  },
  "protocols": {
    "stableWireIds": ["firewater", "justfloat", "raw"],
    "wireIdEvolution": "append-only",
    "runtimePluginAbi": "unsupported"
  },
  "deprecation": {
    "minimumNoticeMinorReleases": 2,
    "minimumNoticeDays": 90,
    "removalRelease": "major-only"
  }
}
