{
  "name": "vofa-ultra",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/woai66/Vofa-Ultra.git"
  },
  "homepage": "https://github.com/woai66/Vofa-Ultra#readme",
  "bugs": {
    "url": "https://github.com/woai66/Vofa-Ultra/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "extension:pack": "node scripts/extension-package.mjs pack",
    "extension:verify": "node scripts/extension-package.mjs verify",
    "build": "tsc -b && vite build",
    "build:desktop": "pnpm supply-chain:bundle && pnpm build",
    "benchmark": "pnpm benchmark:run && pnpm benchmark:verify",
    "benchmark:run": "vitest bench --run -c vitest.bench.config.ts --outputJson artifacts/performance/vitest.json",
    "benchmark:verify": "node scripts/performance-budget.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:tooling && pnpm build",
    "check:package": "node scripts/package-artifacts.mjs verify",
    "check:release": "node scripts/release-artifacts.mjs verify",
    "preview": "vite preview --host 127.0.0.1",
    "package:collect": "node scripts/package-artifacts.mjs collect",
    "release:stage": "node scripts/release-artifacts.mjs stage",
    "supply-chain:bundle": "node scripts/supply-chain.mjs bundle",
    "supply-chain:check": "node scripts/supply-chain.mjs check",
    "supply-chain:generate": "node scripts/supply-chain.mjs generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:tooling": "node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "tauri": "node scripts/tauri-cli.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "crc": "4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": "10.2.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.3.0",
    "jsdom": "30.0.1",
    "spdx-expression-parse": "5.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "4.1.11",
    "yaml": "2.8.2"
  }
}
